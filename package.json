{
  "name": "button-glyphs",
  "version": "0.3.4",
  "description": "Decky plugin that swaps in-game button prompts to PlayStation or Xbox style",
  "homepage": "https://github.com/evertonfxavier/button-glyphs",
  "repository": {"type": "git", "url": "git+https://github.com/evertonfxavier/button-glyphs.git"},
  "bugs": {"url": "https://github.com/evertonfxavier/button-glyphs/issues"},
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "rollup -c",
    "build:zip": "bash scripts/build-zip.sh",
    "build:ci": "bash scripts/ci-build-zip.sh",
    "glyphs": "node scripts/render-glyphs.mjs",
    "brand": "node scripts/render-brand.mjs",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests"
  },
  "keywords": ["decky", "decky-plugin", "steam-deck", "controller", "glyphs"],
  "author": "Everton Xavier",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.4",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.1.11",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
